---
import { Building2, Scale, Shield, Users } from '@lucide/astro';
import Card from '@/components/card/Card.astro';
import CardContent from '@/components/card/CardContent.astro';
// import { getLangFromUrl, useTranslations } from '@/i18n/utils';

// const lang = getLangFromUrl(Astro.url);
// const t = useTranslations(lang);

// TODO: add translations
// Fix: styles by hover and transitions
// chore: verify card and card content styles
---

<section id="services" class="py-20 bg-white">
  <div class="container mx-auto px-4 lg:px-6">
    <div class="text-center mb-16">
      <h2 class="text-3xl lg:text-4xl font-bold text-slate-900 mb-4">Nuestras Especialidades</h2>
      <p class="text-xl text-slate-600 max-w-3xl mx-auto">
        Ofrecemos servicios legales integrales con la experiencia y dedicación que su caso merece en
        las principales áreas del derecho.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
      <Card
        class="group hover:shadow-xl transition-all duration-300 border-primary-200 hover:border-primary-300"
      >
        <CardContent class="p-8 text-center">
          <div class="mb-6">
            <div
              class="w-16 h-16 bg-primary-100 rounded-full flex items-center justify-center mx-auto group-hover:bg-primary-200 transition-colors"
            >
              <Shield class="h-8 w-8 text-primary-600" />
            </div>
          </div>
          <h3 class="text-xl font-bold text-primary-800 mb-3">Derecho Penal</h3>
          <p class="text-primary-600 mb-4">
            Defensa especializada en casos penales, desde delitos menores hasta procesos complejos.
          </p>
          <ul class="text-sm text-primary-500 space-y-1">
            <li>• Defensa penal</li>
            <li>• Amparo penal</li>
            <li>• Delitos económicos</li>
          </ul>
        </CardContent>
      </Card>

      <Card
        class="group hover:shadow-xl transition-all duration-300 border-primary-200 hover:border-primary-300"
      >
        <CardContent class="p-8 text-center">
          <div class="mb-6">
            <div
              class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto group-hover:bg-blue-200 transition-colors"
            >
              <Scale class="h-8 w-8 text-blue-600" />
            </div>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">Derecho Civil</h3>
          <p class="text-slate-600 mb-4">
            Asesoría integral en asuntos civiles, contratos y resolución de conflictos
            patrimoniales.
          </p>
          <ul class="text-sm text-slate-500 space-y-1">
            <li>• Contratos civiles</li>
            <li>• Daños y perjuicios</li>
            <li>• Propiedad inmobiliaria</li>
          </ul>
        </CardContent>
      </Card>

      <Card
        class="group hover:shadow-xl transition-all duration-300 border-primary-200 hover:border-primary-300"
      >
        <CardContent class="p-8 text-center">
          <div class="mb-6">
            <div
              class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto group-hover:bg-green-200 transition-colors"
            >
              <Users class="h-8 w-8 text-green-600" />
            </div>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">Derecho Familiar</h3>
          <p class="text-slate-600 mb-4">
            Acompañamiento sensible y profesional en asuntos familiares y de pareja.
          </p>
          <ul class="text-sm text-slate-500 space-y-1">
            <li>• Divorcios</li>
            <li>• Custodia de menores</li>
            <li>• Pensión alimenticia</li>
          </ul>
        </CardContent>
      </Card>

      <Card
        class="group hover:shadow-xl transition-all duration-300 border-primary-200 hover:border-primary-300"
      >
        <CardContent class="p-8 text-center">
          <div class="mb-6">
            <div
              class="w-16 h-16 bg-purple-100 rounded-full flex items-center justify-center mx-auto group-hover:bg-purple-200 transition-colors"
            >
              <Building2 class="h-8 w-8 text-purple-600" />
            </div>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">Derecho Corporativo</h3>
          <p class="text-slate-600 mb-4">
            Asesoría empresarial integral para el crecimiento y protección de su negocio.
          </p>
          <ul class="text-sm text-slate-500 space-y-1">
            <li>• Constitución de empresas</li>
            <li>• Contratos comerciales</li>
            <li>• Fusiones y adquisiciones</li>
          </ul>
        </CardContent>
      </Card>
    </div>
  </div>
</section>
