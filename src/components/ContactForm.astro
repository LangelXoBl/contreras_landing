---
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import Card from './card/Card.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Card class="p-8 border-primary-200">
  <h3 class="text-2xl font-bold text-primary-800 mb-6">{t('contact.title')}</h3>
  <form class="space-y-4">
    <div class="grid sm:grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-2"
          >{t('contact.name.label')}</label
        >
        <input
          placeholder={t('contact.name.placeholder')}
          class="w-full rounded-md border px-3 py-2 text-sm border-gray-300"
        />
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-2">{t('contact.phone')}</label>
        <input
          placeholder="Tu número de teléfono"
          class="w-full rounded-md border px-3 py-2 text-sm border-gray-300"
        />
      </div>
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-2">{t('contact.email')}</label>
      <input
        type="email"
        placeholder="tu@email.com"
        class="w-full rounded-md border px-3 py-2 text-sm border-gray-300"
      />
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-2">{t('contact.subject')}</label>
      <select
        class="w-full p-3 border border-gray-300 rounded-md focus:ring-2 focus:ring-slate-500 focus:border-transparent"
      >
        <option>Selecciona un área</option>
        <option>Derecho Penal</option>
        <option>Derecho Civil</option>
        <option>Derecho Familiar</option>
        <option>Derecho Corporativo</option>
      </select>
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-2">{t('contact.message')}</label>
      <textarea
        placeholder="Describe brevemente tu situación legal..."
        rows={4}
        class="w-full rounded-md border px-3 py-2 text-sm border-gray-300"></textarea>
    </div>
    <button class="w-full bg-primary-600 hover:bg-primary-700 text-white py-3 rounded-md"
      >{t('contact.submit')}</button
    >
  </form>
</Card>
